#!/usr/bin/env python3
"""A stand-in for 1Password's `op` in the import tests: it answers from
tests/import/fixtures/op.json ($FAKE_OP_FIXTURE) and logs every argv to
$FAKE_OP_LOG. FAKE_OP_FAIL=1 makes every call fail the way op does when the
app's prompt is dismissed. Never the real op, never a real account."""
import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["FAKE_OP_LOG"], "a") as log:
    log.write(" ".join(argv) + "\n")
if os.environ.get("FAKE_OP_FAIL"):
    sys.stderr.write("[ERROR] 2026/10/14 22:00:00 authorization prompt dismissed, please try again\n")
    sys.exit(1)
if "--account" in argv:
    i = argv.index("--account")
    del argv[i:i + 2]
fx = json.load(open(os.environ["FAKE_OP_FIXTURE"]))


def opt(name):
    return argv[argv.index(name) + 1] if name in argv else None


def out(obj):
    sys.stdout.write(json.dumps(obj))


if argv[:2] == ["vault", "list"]:
    out(fx["vaults"])
elif argv[:2] == ["item", "list"]:
    items = fx["lists"].get(opt("--vault"), [])
    if "--include-archive" not in argv:
        items = [i for i in items if i.get("state") != "ARCHIVED"]
    out(items)
elif argv[:2] == ["item", "get"]:
    item = fx["items"].get(argv[2])
    if item is None or (item.get("state") == "ARCHIVED" and "--include-archive" not in argv):
        sys.stderr.write('[ERROR] "%s" isn\'t an item in the vault\n' % argv[2])
        sys.exit(1)
    out(item)
elif argv[:2] == ["document", "get"]:
    sys.stdout.write(fx["documents"][argv[2]])
elif argv[:1] == ["read"]:
    ref = [a for a in argv if a.startswith("op://")][0]
    if ref not in fx["files"]:
        sys.stderr.write("[ERROR] could not read secret '%s'\n" % ref)
        sys.exit(1)
    sys.stdout.write(fx["files"][ref])
else:
    sys.stderr.write("[ERROR] unknown command %r\n" % argv)
    sys.exit(1)
