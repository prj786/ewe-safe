# Safe, ewe's password manager: the sockets. The daemon starts on the first
# connection (the Super+P picker, the Safe app, `ewe-safe`, or ssh through
# the SSH agent) and keeps the safe unlocked across shell restarts (PLAN.md
# §4, docs/PROTOCOL.md). The daemon tells the two apart by their paths.
[Unit]
Description=Safe, ewe's password manager (socket)
Documentation=https://github.com/prj786/ewe-safe

[Socket]
ListenStream=%t/ewe-safe.sock
# the SSH agent (`ewe-safe ssh enable` points SSH_AUTH_SOCK here)
ListenStream=%t/ewe-safe-ssh.sock
SocketMode=0600
DirectoryMode=0700

[Install]
WantedBy=sockets.target
