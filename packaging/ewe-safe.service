# Safe, ewe's password manager: the daemon that holds the unlocked safe.
# Started by ewe-safe.socket; stopping it (logout) locks the safe.
[Unit]
Description=ewe Safe, the password manager
Documentation=https://github.com/prj786/ewe-safe
Requires=ewe-safe.socket
After=ewe-safe.socket

[Service]
Type=simple
ExecStart=/usr/bin/ewe-safed
Restart=on-failure
RestartSec=2

# No core dumps of a process that holds secrets (the daemon also makes
# itself undumpable). PLAN.md §8.
LimitCORE=0
NoNewPrivileges=yes
# No PrivateTmp=, ProtectSystem=, ReadWritePaths= or anything else that needs
# a mount namespace: a user service gets one only inside its own user
# namespace, and from there the kernel hides /proc/<pid>/exe of every program
# outside it. The SSH agent then can't tell who asks for a key, and asks every
# time (docs/PROTOCOL.md, "The SSH agent"; crates/cli/tests/ssh.rs guards it).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
Also=ewe-safe.socket
