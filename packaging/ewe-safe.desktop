[Desktop Entry]
Type=Application
Name=ewe Safe
GenericName=Passwords, passkeys and SSH keys
Comment=Your passwords in one file that only you can open
Exec=ewe-safe-app
Icon=ewe-safe
Terminal=false
Categories=Utility;Security;
Keywords=password;passwords;password manager;passkey;passkeys;ssh;keepass;kdbx;1password;login;vault;safe;ewe;
StartupWMClass=ewe-safe
Actions=new-login;import;

[Desktop Action new-login]
Name=New login
Exec=ewe-safe-app --new

[Desktop Action import]
Name=Import from 1Password
Exec=ewe-safe-app --import
